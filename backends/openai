#!/usr/bin/env python3
"""OpenAI-compatible adapter for Scribe. See backends/README.md.

Speaks the /v1/chat/completions shape, which is what OpenAI, ollama,
llama.cpp's server, LM Studio, vLLM, OpenRouter, Groq and most local runners
expose. Point it somewhere with SCRIBE_OPENAI_BASE_URL:

    ollama       SCRIBE_OPENAI_BASE_URL=http://localhost:11434/v1
    llama.cpp    SCRIBE_OPENAI_BASE_URL=http://localhost:8080/v1
    OpenAI       (the default; needs a key)

Local servers usually want no key at all, so a missing key is only an error
when the endpoint is a remote one.
"""

import json
import os
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request

EXIT_OK = 0
EXIT_CONFIG = 2
EXIT_UPSTREAM = 3

DEFAULT_BASE_URL = "https://api.openai.com/v1"

KEYRING_ARGS = ["secret-tool", "lookup", "service", "openai", "account", "api-key"]

KEY_HELP = (
    "No API key for %s. Either export SCRIBE_OPENAI_API_KEY (or OPENAI_API_KEY), or store one "
    "with:  secret-tool store --label='OpenAI API key' service openai account api-key"
)


def fail(code, message):
    print(message, file=sys.stderr)
    sys.exit(code)


def base_url():
    return (os.environ.get("SCRIBE_OPENAI_BASE_URL") or os.environ.get("OPENAI_BASE_URL")
            or DEFAULT_BASE_URL).rstrip("/")


def is_local(url):
    host = (urllib.parse.urlparse(url).hostname or "").lower()
    return host in ("localhost", "127.0.0.1", "::1", "0.0.0.0") or host.endswith(".local")


def resolve_key():
    for name in ("SCRIBE_OPENAI_API_KEY", "OPENAI_API_KEY"):
        key = (os.environ.get(name) or "").strip()
        if key:
            return key
    try:
        completed = subprocess.run(KEYRING_ARGS, capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return ""
    return completed.stdout.strip() if completed.returncode == 0 else ""


def check():
    url = base_url()
    key = resolve_key()
    if not key and not is_local(url):
        fail(EXIT_CONFIG, KEY_HELP % url)
    print("endpoint %s%s" % (url, "" if not key else " (key …%s)" % key[-4:]))
    return EXIT_OK


def main():
    if "--check" in sys.argv[1:]:
        return check()

    try:
        payload = json.load(sys.stdin)
    except ValueError as exc:
        fail(EXIT_UPSTREAM, "adapter received invalid JSON: %s" % exc)

    url = base_url()
    key = resolve_key()
    if not key and not is_local(url):
        fail(EXIT_CONFIG, KEY_HELP % url)

    body = {
        "model": payload.get("model") or "gpt-4o-mini",
        "messages": [
            {"role": "system", "content": payload["system"]},
            {"role": "user", "content": "<text>\n%s\n</text>" % payload["text"]},
        ],
        "stream": False,
    }

    headers = {"content-type": "application/json"}
    if key:
        headers["authorization"] = "Bearer %s" % key

    request = urllib.request.Request(
        url + "/chat/completions",
        data=json.dumps(body, ensure_ascii=False).encode("utf-8"),
        headers=headers,
        method="POST",
    )

    timeout = payload.get("timeoutSec") or 30
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            answer = json.loads(response.read().decode("utf-8"))
    except urllib.error.HTTPError as exc:
        detail = ""
        try:
            problem = json.loads(exc.read().decode("utf-8"))
            detail = (problem.get("error") or {}).get("message", "")
        except Exception:
            pass
        code = EXIT_CONFIG if exc.code in (401, 403) else EXIT_UPSTREAM
        fail(code, "%s returned %d%s" % (url, exc.code, (": " + detail) if detail else ""))
    except urllib.error.URLError as exc:
        fail(EXIT_UPSTREAM, "Could not reach %s: %s" % (url, exc.reason))
    except (ValueError, TimeoutError) as exc:
        fail(EXIT_UPSTREAM, "Bad response from %s: %s" % (url, exc))

    choices = answer.get("choices") or []
    if not choices:
        fail(EXIT_UPSTREAM, "%s returned no choices." % url)

    choice = choices[0]
    if choice.get("finish_reason") == "length":
        fail(EXIT_UPSTREAM, "The correction was cut off; the selection is too long.")

    text = ((choice.get("message") or {}).get("content")) or ""
    if not text.strip():
        fail(EXIT_UPSTREAM, "%s returned no text." % url)

    usage = answer.get("usage") or {}
    result = {"text": text, "model": answer.get("model") or body["model"]}
    if usage:
        result["usage"] = {
            "input_tokens": usage.get("prompt_tokens"),
            "output_tokens": usage.get("completion_tokens"),
        }

    json.dump(result, sys.stdout, ensure_ascii=False)
    sys.stdout.write("\n")
    return EXIT_OK


if __name__ == "__main__":
    sys.exit(main())
