#!/usr/bin/env python3
"""Claude Code CLI adapter for Scribe. See backends/README.md for the contract.

Needs no API key -- it borrows whatever `claude` is already logged in with,
which for most people is their Claude subscription rather than API billing.
The tradeoff is startup: a node process boots per correction, so expect a few
seconds where the `anthropic` adapter takes about one. Corrections also count
against subscription usage.

Tools are disabled explicitly. A proofreader has no business reading files,
and a model that reaches for Read on text that mentions a path would be both
slow and surprising.
"""

import json
import shutil
import subprocess
import sys

EXIT_OK = 0
EXIT_CONFIG = 2
EXIT_UPSTREAM = 3


def fail(code, message):
    print(message, file=sys.stderr)
    sys.exit(code)


def check():
    if not shutil.which("claude"):
        fail(EXIT_CONFIG, "The `claude` CLI is not on PATH. Install Claude Code to use this backend.")
    print("claude found at %s" % shutil.which("claude"))
    return EXIT_OK


def main():
    if "--check" in sys.argv[1:]:
        return check()

    if not shutil.which("claude"):
        fail(EXIT_CONFIG, "The `claude` CLI is not on PATH. Install Claude Code to use this backend.")

    try:
        payload = json.load(sys.stdin)
    except ValueError as exc:
        fail(EXIT_UPSTREAM, "adapter received invalid JSON: %s" % exc)

    model = payload.get("model") or "opus"
    timeout = payload.get("timeoutSec") or 30

    command = [
        "claude",
        "--print",
        "--output-format", "json",
        "--model", model,
        "--system-prompt", payload["system"],
        # "" disables the built-in tool set entirely.
        "--tools", "",
        "--max-turns", "1",
    ]

    # The text goes in on stdin, never as an argv element: a marked selection
    # can be far larger than ARG_MAX and can contain anything at all.
    prompt = "<text>\n%s\n</text>" % payload["text"]

    try:
        completed = subprocess.run(
            command, input=prompt, capture_output=True, text=True, timeout=timeout
        )
    except subprocess.TimeoutExpired:
        fail(EXIT_UPSTREAM, "`claude` did not answer within %ds." % timeout)
    except OSError as exc:
        fail(EXIT_CONFIG, "Could not run `claude`: %s" % exc)

    if completed.returncode != 0:
        detail = (completed.stderr or completed.stdout or "").strip().splitlines()
        fail(EXIT_UPSTREAM, detail[-1] if detail else "`claude` exited %d." % completed.returncode)

    try:
        answer = json.loads(completed.stdout)
    except ValueError:
        fail(EXIT_UPSTREAM, "`claude` did not return JSON.")

    if answer.get("is_error"):
        fail(EXIT_UPSTREAM, str(answer.get("result") or "`claude` reported an error."))

    text = answer.get("result")
    if not isinstance(text, str) or not text.strip():
        fail(EXIT_UPSTREAM, "`claude` returned no text.")

    usage = answer.get("usage") or {}
    result = {"text": text, "model": answer.get("model") or model}
    if usage.get("input_tokens") is not None or usage.get("output_tokens") is not None:
        result["usage"] = {
            "input_tokens": usage.get("input_tokens"),
            "output_tokens": usage.get("output_tokens"),
        }

    json.dump(result, sys.stdout, ensure_ascii=False)
    sys.stdout.write("\n")
    return EXIT_OK


if __name__ == "__main__":
    sys.exit(main())
